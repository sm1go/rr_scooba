# TalentMatch Signal — copy to .env (git-ignored) and fill in.

# LLM provider for the AI suggestion steps: mock | nvidia | gemma
# Default and automatic fallback is mock (recorded outputs in db/seed/recorded/).
LLM_PROVIDER=mock

# NVIDIA Build — Nemotron 3.5 Super VL (Need Compiler / story interview)
NVIDIA_API_KEY=

# Gemma on Modal (vLLM, OpenAI-compatible) — story interview
GEMMA_BASE_URL=
GEMMA_MODEL=gemma-3-27b-it
