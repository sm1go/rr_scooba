# Espoo Work Map — copy to .env (git-ignored) and fill in.

# Override the SQLite location (defaults to db/talentmatch.sqlite)
TM_DB_PATH=

# Optional AI helpers (photo->draft, simplify, call script, note->record).
# Missing -> GET /api/config returns ai:false and every fallback applies.
NVIDIA_API_KEY=
# Model override; default nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL=

# Optional HSL commute routing (api.digitransit.fi registration key).
# Missing -> commute:false; distance and nearest-station lines stay.
DIGITRANSIT_API_KEY=

# Base URL printed inside QR codes; frontend falls back to its own origin.
PUBLIC_BASE_URL=
